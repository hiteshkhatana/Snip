VITE_API_URL=http://localhost:4000
# The public base URL short links redirect from. In this project the same
# backend server serves both the JSON API and the GET /:code redirects, so
# this is the same value as VITE_API_URL — but kept separate in case a real
# deployment ever serves short links from a different domain.
VITE_SHORT_URL_BASE=http://localhost:4000
